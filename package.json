{
  "name": "cloudframe-media-platform",
  "version": "1.0.0",
  "description": "Professional media management platform with AI-powered asset optimization",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:backend": "node --watch server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "node server.js",
    "install:all": "npm install && cd frontend && npm install"
  },
  "keywords": [
    "cloudinary",
    "media",
    "gallery",
    "upload",
    "transformation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cloudinary": "^1.40.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0"
  },
  "devDependencies": {}
}
